---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Search from '../components/Search.astro';
import { getCollection } from 'astro:content';

const RECENT_COUNT = 10;

const pages = await getCollection('wiki', ({ data }) => !data.draft);
const pageData = pages
  .map(p => ({
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags,
    date: p.data.date,
  }))
  .sort((a, b) => {
    if (!a.date && !b.date) return 0;
    if (!a.date) return 1;
    if (!b.date) return -1;
    return b.date.getTime() - a.date.getTime();
  });

const recentPages = pageData.slice(0, RECENT_COUNT);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const startHereSlugs = [
  'backpropagation',
  'understanding-lstms',
  'seq2seq',
  'bahdanau-attention',
  'transformer',
  'gpt',
  'reinforcement-learning',
  'policy-gradient',
];

const startHerePages = startHereSlugs
  .map(slug => pageData.find(page => page.slug === slug))
  .filter((page): page is (typeof pageData)[number] => Boolean(page));
---

<Base title="Home">
  <div class="max-w-2xl mx-auto px-4 pt-16 pb-12 text-center">
    <h1 class="mb-4">
      <Logo size="xl" />
    </h1>
    <p class="text-text-secondary text-lg mb-8 text-balance">
      AI and machine learning concepts explained with interactive visuals
    </p>
    <Search variant="inline" />
    <p class="mt-4 text-sm text-text-secondary">
      {pages.length} articles · press <kbd
        class="font-mono text-[11px] px-1.5 py-0.5 rounded border border-border bg-bg-secondary">⌘K</kbd
      > anywhere
    </p>
  </div>

  <section class="max-w-2xl mx-auto px-4 pb-12">
    <h2 class="text-xs font-medium text-text-secondary mb-2 uppercase tracking-widest">Start here</h2>
    <p class="text-sm text-text-secondary mb-6">
      New to the field? Follow this path from fundamentals to modern models.
    </p>
    <ol class="divide-y divide-border border-y border-border">
      {
        startHerePages.map((page, index) => (
          <li>
            <a
              href={`/${page.slug}`}
              class="group flex items-start gap-4 py-4 hover:bg-bg-secondary/40 -mx-4 px-4 transition-colors"
            >
              <span class="text-xs text-text-secondary pt-1 w-6 shrink-0 tabular-nums">{index + 1}</span>
              <span class="block">
                <span class="block font-medium group-hover:underline mb-1">{page.title}</span>
                <span class="block text-sm text-text-secondary">{page.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="max-w-2xl mx-auto px-4 pb-20">
    <h2 class="text-xs font-medium text-text-secondary mb-4 uppercase tracking-widest">Recently added</h2>
    <ul class="divide-y divide-border border-y border-border">
      {
        recentPages.map(page => (
          <li>
            <a
              href={`/${page.slug}`}
              class="group block py-4 hover:bg-bg-secondary/40 -mx-4 px-4 transition-colors"
            >
              <span class="flex items-baseline justify-between gap-4 mb-1">
                <span class="font-medium group-hover:underline">{page.title}</span>
                {page.date && (
                  <time datetime={page.date.toISOString()} class="text-xs text-text-secondary shrink-0">
                    {formatDate(page.date)}
                  </time>
                )}
              </span>
              <span class="block text-sm text-text-secondary">{page.description}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex gap-6 text-sm text-text-secondary mt-6">
      <a href="/browse" class="hover:text-text transition-colors">All {pages.length} topics →</a>
      <a href="/tags" class="hover:text-text transition-colors">Browse by tag</a>
    </div>
  </section>
</Base>
