---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('wiki', ({ data }) => !data.draft);
  const allTags = [...new Set(pages.flatMap(p => p.data.tags))];

  return allTags.map(tag => ({
    params: { tag },
    props: {
      tag,
      pages: pages
        .filter(p => p.data.tags.includes(tag))
        .sort((a, b) => a.data.title.localeCompare(b.data.title)),
    },
  }));
}

const { tag, pages } = Astro.props;
---

<Base title={`#${tag}`} description={`AIpedia articles tagged ${tag}.`}>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex items-center gap-2 text-text-secondary">
        <li><a href="/" class="hover:text-text transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/tags" class="hover:text-text transition-colors">Tags</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-text" aria-current="page">{tag}</li>
      </ol>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
        <span class="text-text-secondary">#</span>{tag}
      </h1>
      <p class="text-text-secondary mt-2">{pages.length} article{pages.length === 1 ? '' : 's'}</p>
    </header>

    <ul class="grid sm:grid-cols-2 gap-4">
      {
        pages.map(page => (
          <li>
            <a
              href={`/${page.slug}`}
              class="group block h-full p-5 rounded-xl border border-border hover:border-border-strong hover:bg-bg-secondary/50 transition-colors"
            >
              <span class="block text-lg font-semibold mb-2 group-hover:underline">{page.data.title}</span>
              <span class="block text-text-secondary text-sm">{page.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
